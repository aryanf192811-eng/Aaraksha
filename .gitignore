# ─── Dependencies ───────────────────────────────────────────────────────
node_modules/
.pnp
.pnp.js

# ─── Environment secrets ────────────────────────────────────────────────
# Never commit real credentials — only *.env.example templates are tracked.
.env
.env.local
.env.*.local
.env.development
.env.production
.env.test

# ─── Logs ────────────────────────────────────────────────────────────────
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ─── Test / coverage output ─────────────────────────────────────────────
coverage/
.nyc_output/
*.lcov

# ─── Build output ───────────────────────────────────────────────────────
dist/
build/
.vite/
*.tsbuildinfo

# ─── Postman/Newman run artifacts ───────────────────────────────────────
# The collection + environment ARE tracked (backend/postman/); only local
# run output is not.
newman/
newman-results.json
*-newman-report.html

# ─── Editor / IDE ────────────────────────────────────────────────────────
.vscode/*
!.vscode/extensions.json
.idea/
*.swp
*.swo
*~

# ─── OS cruft ────────────────────────────────────────────────────────────
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
Thumbs.db
ehthumbs.db
Desktop.ini

# ─── Runtime / misc ──────────────────────────────────────────────────────
*.pid
*.seed
*.pid.lock
.cache/
.tmp/

# ─── User-uploaded content ───────────────────────────────────────────────
# Review photos land on local disk (no cloud storage configured) — never
# committed, only the upload directory structure matters for dev setup.
backend/uploads/

# ─── Internal build/session artifacts ───────────────────────────────────
# Raw AI-prompting and session-log docs — useful locally while developing,
# not published to keep the repo reading as a normal engineering project.
CLAUDE.md
BACKEND_PROMPT.md
FRONTEND_PROMPT*.md
postman-check.md

# ─── Locally-installed AI coding-assistant skills ───────────────────────
# Third-party skill packages (e.g. ui-ux-pro-max-cli), not project source.
.claude/skills/

# ─── Design tool exports ─────────────────────────────────────────────────
# Raw Stitch export archives used as redesign input — already applied to
# frontend/*, not part of the buildable source tree.
stitch_*.zip

# ─── Local testing / MCP tool output ─────────────────────────────────────
# Playwright MCP session artifacts (screenshots, DOM snapshots, console
# logs) generated while manually verifying changes — not test fixtures.
.playwright-mcp/
